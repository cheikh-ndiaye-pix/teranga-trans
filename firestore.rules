rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }
    function isActiveDriver() {
      return isSignedIn() && userDoc().role == 'chauffeur' && userDoc().status == 'active';
    }
    function isActiveClient() {
      return isSignedIn() && userDoc().role == 'client' && userDoc().status == 'active';
    }
    // Doit rester identique a ADMIN_EMAILS dans le HTML de l'application.
    // request.auth.token.email vient de Firebase Auth : impossible a falsifier.
    function isAdminEmail() {
      return isSignedIn() && request.auth.token.email.lower() in
        ['papacheikh900@gmail.com'];
    }

    // --- users ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Inscription libre pour client/admin : actifs immediatement.
      // Un chauffeur doit d'abord etre valide par un admin : son compte
      // est cree en status 'pending' (voir renderPendingDriver dans le HTML).
      allow create: if isSignedIn() && request.auth.uid == userId
                    && (
                      (request.resource.data.role == 'client' && request.resource.data.status == 'active')
                      ||
                      (request.resource.data.role == 'chauffeur' && request.resource.data.status == 'pending')
                      ||
                      (request.resource.data.role == 'admin' && isAdminEmail() && request.resource.data.status == 'active')
                    );

      // Seul l'admin peut changer role/status/email.
      // Un utilisateur ne peut modifier que son nom et son telephone.
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == userId
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['nom', 'telephone']));

      allow delete: if isAdmin();
    }

    // --- buses (flotte) ---
    match /buses/{busId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- reservations ---
    match /reservations/{resId} {
      allow read: if isSignedIn() && (
                     resource.data.clientId == request.auth.uid ||
                     resource.data.chauffeurId == request.auth.uid ||
                     isAdmin()
                   );

      allow create: if
                    // Cas normal : un client actif cree une demande "propre",
                    // en_attente, sans bus/chauffeur/prix pre-remplis (ca,
                    // c'est le travail de l'admin lors de la confirmation,
                    // ou d'un chauffeur qui propose ensuite un prix).
                    (
                      isActiveClient()
                      && request.resource.data.clientId == request.auth.uid
                      && request.resource.data.statut == 'en_attente'
                      && request.resource.data.busId == null
                      && request.resource.data.chauffeurId == null
                      && request.resource.data.busImmat == null
                      && request.resource.data.chauffeurNom == null
                      && request.resource.data.prix == null
                    )
                    ||
                    // Cas "trajet publie par un chauffeur" : le client
                    // reserve directement un trajet deja propose (voir
                    // trajetsProposes plus bas), la reservation est creee
                    // deja confirmee avec chauffeur/bus/prix pre-remplis.
                    (
                      isActiveClient()
                      && request.resource.data.clientId == request.auth.uid
                      && request.resource.data.statut == 'confirmee'
                      && request.resource.data.chauffeurId != null
                      && request.resource.data.prix is number
                      && request.resource.data.prix > 0
                      && request.resource.data.paiementStatut == 'non_paye'
                    );

      allow update: if isAdmin() || (
                      isActiveDriver() &&
                      resource.data.chauffeurId == request.auth.uid &&
                      (
                        (resource.data.statut == 'confirmee' && request.resource.data.statut == 'en_route') ||
                        (resource.data.statut == 'en_route' && request.resource.data.statut == 'terminee')
                      ) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut'])
                    ) || (
                      // Le client peut annuler sa propre demande tant qu'elle
                      // n'est pas encore en route / terminee / deja annulee.
                      isActiveClient() &&
                      resource.data.clientId == request.auth.uid &&
                      resource.data.statut in ['en_attente', 'confirmee'] &&
                      request.resource.data.statut == 'annulee' &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut'])
                    ) || (
                      // Le client peut noter un trajet termine, une seule fois.
                      isActiveClient() &&
                      resource.data.clientId == request.auth.uid &&
                      resource.data.statut == 'terminee' &&
                      request.resource.data.statut == 'terminee' &&
                      (!('note' in resource.data) || resource.data.note == null) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'avis'])
                    ) || (
                      // Le client accepte l'offre d'un chauffeur sur sa propre
                      // demande (marche des propositions) : en_attente -> confirmee,
                      // avec chauffeur/bus/prix fixes par l'offre choisie.
                      isActiveClient() &&
                      resource.data.clientId == request.auth.uid &&
                      resource.data.statut == 'en_attente' &&
                      request.resource.data.statut == 'confirmee' &&
                      request.resource.data.chauffeurId != null &&
                      request.resource.data.prix is number &&
                      request.resource.data.prix > 0 &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'statut', 'chauffeurId', 'chauffeurNom', 'chauffeurTelephone',
                        'busId', 'busImmat', 'busEquipements',
                        'prix', 'commission', 'montantChauffeur', 'paiementStatut'
                      ])
                    );

      allow delete: if isAdmin();
    }

    // --- rechargements (historique des recharges de portefeuille PayTech) ---
    // Toutes les ecritures passent exclusivement par les Cloud Functions
    // (Admin SDK, qui contourne ces regles) : createPaytechPayment cree la
    // demande, paytechIPN la valide/echoue apres reponse de PayTech. Aucune
    // ecriture cote client n'est autorisee, pour eviter qu'un client ne
    // s'auto-credite en creant/modifiant un document directement.
    match /rechargements/{rechId} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // --- propositions (un chauffeur propose un prix sur une demande client) ---
    match /propositions/{propId} {
      allow read: if isSignedIn() && (
                     resource.data.chauffeurId == request.auth.uid ||
                     resource.data.clientId == request.auth.uid ||
                     isAdmin()
                   );

      // Un chauffeur actif ne peut proposer que sur une demande client
      // encore ouverte (en_attente), et le clientId denormalise doit
      // correspondre au vrai proprietaire de la demande.
      allow create: if isActiveDriver()
                    && request.resource.data.chauffeurId == request.auth.uid
                    && request.resource.data.statut == 'en_attente'
                    && request.resource.data.prixPropose is number
                    && request.resource.data.prixPropose > 0
                    && get(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.statut == 'en_attente'
                    && get(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.clientId == request.resource.data.clientId;

      // Le client concerne accepte ou refuse une offre recue.
      allow update: if isAdmin() || (
                      isActiveClient() &&
                      resource.data.clientId == request.auth.uid &&
                      resource.data.statut == 'en_attente' &&
                      request.resource.data.statut in ['acceptee', 'refusee'] &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut'])
                    );

      // Le chauffeur peut retirer sa propre offre tant qu'elle est en attente.
      allow delete: if isAdmin() || (
                      isActiveDriver() &&
                      resource.data.chauffeurId == request.auth.uid &&
                      resource.data.statut == 'en_attente'
                    );
    }

    // --- trajetsProposes (un chauffeur publie un trajet a l'avance) ---
    match /trajetsProposes/{trajetId} {
      // Lecture ouverte a tout utilisateur connecte : les clients doivent
      // pouvoir parcourir/rechercher tous les trajets ouverts.
      allow read: if isSignedIn();

      allow create: if isActiveDriver()
                    && request.resource.data.chauffeurId == request.auth.uid
                    && request.resource.data.statut == 'ouvert'
                    && request.resource.data.prixPropose is number
                    && request.resource.data.prixPropose > 0
                    && request.resource.data.placesDisponibles is number
                    && request.resource.data.placesDisponibles > 0;

      allow update: if isAdmin() || (
                      // Le chauffeur proprietaire retire son trajet.
                      isActiveDriver() &&
                      resource.data.chauffeurId == request.auth.uid &&
                      resource.data.statut == 'ouvert' &&
                      request.resource.data.statut == 'annule' &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut'])
                    ) || (
                      // Le chauffeur proprietaire modifie les details de son
                      // trajet (prix, date, places, bus...) tant qu'il est
                      // encore ouvert (pas deja reserve par un client).
                      isActiveDriver() &&
                      resource.data.chauffeurId == request.auth.uid &&
                      resource.data.statut == 'ouvert' &&
                      request.resource.data.statut == 'ouvert' &&
                      request.resource.data.chauffeurId == resource.data.chauffeurId &&
                      request.resource.data.prixPropose is number &&
                      request.resource.data.prixPropose > 0 &&
                      request.resource.data.placesDisponibles is number &&
                      request.resource.data.placesDisponibles > 0 &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'lieuDepart', 'lieuArrivee', 'dateEvenement', 'placesDisponibles',
                        'prixPropose', 'commission', 'prixTotal',
                        'busId', 'busImmat', 'busEquipements', 'message'
                      ])
                    ) || (
                      // Un client actif reserve un trajet encore ouvert.
                      isActiveClient() &&
                      resource.data.statut == 'ouvert' &&
                      request.resource.data.statut == 'reserve' &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut'])
                    );

      allow delete: if isAdmin();
    }
  }
}
